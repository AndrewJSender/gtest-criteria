@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(GTest CONFIG)
find_dependency(SQLite3)
if(NOT TARGET SQLite3::SQLite3 AND TARGET SQLite::SQLite3)
  add_library(SQLite3::SQLite3 INTERFACE IMPORTED)
  set_property(TARGET SQLite3::SQLite3 PROPERTY
    INTERFACE_LINK_LIBRARIES SQLite::SQLite3)
endif()
if(@GTEST_CRITERIA_WITH_POSTGRESQL@)
  find_dependency(PostgreSQL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/GTestCriteriaTargets.cmake")

check_required_components(GTestCriteria)
